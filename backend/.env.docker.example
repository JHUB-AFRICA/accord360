# Local Docker Compose settings. Change these before sharing the environment.
POSTGRES_DB=accord360
POSTGRES_USER=accord360
POSTGRES_PASSWORD=accord360_dev_password
BACKEND_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=accord360
MINIO_ROOT_PASSWORD=change-this-minio-password
ENVIRONMENT=development
SECRET_KEY=change-this-before-production-use-at-least-32-characters
SEED_DEMO_DATA=true
OBJECT_STORAGE_ENABLED=true
AWS_ENDPOINT_URL_S3=http://minio:9000
AWS_ACCESS_KEY_ID=accord360
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_REGION=us-east-2
AWS_BUCKET_NAME=accord-360
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_SESSION_TTL_SECONDS=1800
AI_MAX_HISTORY_MESSAGES=20
EMAIL_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Accord 360
# SMTP settings are used when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Resend settings are used when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
