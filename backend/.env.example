APP_NAME=Accord 360
ENVIRONMENT=development
SECRET_KEY=change-this-before-production-use-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Local SQLite (default):
DATABASE_URL=sqlite:///./accord360.db
# Neon PostgreSQL (replace placeholders and uncomment):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
UPLOAD_DIR=uploads
OBJECT_STORAGE_ENABLED=true
AWS_ENDPOINT_URL_S3=https://<your-neon-storage-endpoint>
AWS_ACCESS_KEY_ID=<your-neon-access-key>
AWS_SECRET_ACCESS_KEY=<your-neon-secret-key>
AWS_REGION=us-east-2
AWS_BUCKET_NAME=accord-360
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
