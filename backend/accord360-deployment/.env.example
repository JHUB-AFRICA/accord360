# Accord 360 deployment settings. `./install.sh` copies this to .env and fills in
# the secrets automatically; edit .env afterwards only if you need to.

# Images built by GitHub Actions and published to Docker Hub. Use a pinned
# `sha-<full-commit>` tag from the Actions run for repeatable releases, or `v1.0`.
IMAGE_REPOSITORY=jhubafrica/accord360-app
RELEASE_TAG=v1.0

APP_NAME=Accord 360
ENVIRONMENT=production
SECRET_KEY=__GENERATE__
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

POSTGRES_DB=accord360
POSTGRES_USER=accord360
POSTGRES_PASSWORD=__GENERATE__

# Backend database connection. Leave these commented to use the bundled
# database above (host "database", same user/password/name as POSTGRES_*).
# Set them to connect to a different PostgreSQL server; the password may
# contain any character, including @ : / %.
# DB_HOST=database
# DB_PORT=5432
# DB_USER=accord360
# DB_PASSWORD=change-me
# DB_NAME=accord360

# The frontend (app + /api proxy) is published on FRONTEND_PORT; put an HTTPS
# reverse proxy in front of it and point the public domain at that port.
# CORS_ORIGINS must be the public URL users type in the browser.
FRONTEND_PORT=8080
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080

# Never true in production.
SEED_DEMO_DATA=false
# Demo deployment: anyone with the link can create an account with just an email + office.
ALLOW_DEMO_SIGNUP=true

# Object storage for documents uploaded by the Linkages office (bundled S3-compatible
# store). To use an external S3 instead, set AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_REGION and AWS_BUCKET_NAME below.
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ROOT_USER=accord360
OBJECT_STORAGE_ROOT_PASSWORD=__GENERATE__
OBJECT_STORAGE_CONSOLE_PORT=9001
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=accord-360

# Google Docs drafting + sharing with partners. The key must be the service
# account's RAW JSON on ONE line (install.sh does this for you from a key file).
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_DEMO_DOC_ID=
DRIVE_ACCESS_SWEEP_MINUTES=2
