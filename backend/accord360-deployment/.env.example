# Replace every placeholder before starting the production deployment.
ACCORD360_IMAGE=ghcr.io/your-organization/accord360-backend:1.0.0
APP_NAME=Accord 360
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

POSTGRES_DB=accord360
POSTGRES_USER=accord360
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# The API is bound to localhost and should be published through HTTPS.
BACKEND_PORT=8000
CORS_ORIGINS=https://accord360.example.com
LOG_LEVEL=INFO
SEED_DEMO_DATA=false

# Set OBJECT_STORAGE_ENABLED=true when using S3-compatible storage.
# Otherwise uploaded documents are kept in the accord360_uploads Docker volume.
OBJECT_STORAGE_ENABLED=false
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=accord-360
